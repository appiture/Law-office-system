{
  "name": "law-office-system",
  "version": "2.0.0",
  "description": "Hardened Law Office System - Supabase & React Production Architecture",
  "scripts": {
    "install:all": "cd frontend && npm install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:supabase": "supabase start",
    "dev": "npm run dev:frontend",
    "setup": "npm run install:all",
    "supabase:gen": "supabase gen types typescript --local > frontend/src/types/supabase.ts",
    "supabase:deploy": "supabase functions deploy"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
